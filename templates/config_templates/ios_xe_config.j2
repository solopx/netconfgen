hostname {{ hostname }}
{% if snmp_community %}
snmp-server community {{ snmp_community }} RO
{% endif %}
{% if ntp_server %}
ntp server {{ ntp_server }}
{% endif %}
{% if syslog_server %}
logging host {{ syslog_server }}
{% endif %}
{% if dns_server %}
ip name-server {{ dns_server }}
{% endif %}

{# VLAN and SVI Configuration #}
{% for vlan in vlans %}
vlan {{ vlan.id }}
  name {{ vlan.name }}
!
{% if vlan.ip_address and vlan.prefix_length %}
interface Vlan{{ vlan.id }}
{% if vlan.description %}
  description {{ vlan.description }}
{% endif %}
  ip address {{ vlan.ip_address }} {{ vlan.prefix_length | ip_prefix_to_netmask }}
{% if vlan.helper_addresses %}
{% for helper in vlan.helper_addresses %}
  ip helper-address {{ helper }}
{% endfor %}
{% endif %}
{% if vlan.shutdown %}
  shutdown
{% else %}
  no shutdown
{% endif %}
!
{% endif %}
{% endfor %}

{# Physical Interface Configuration #}
{% for interface in interfaces %}
{% if '-' in interface.name %}
interface range {{ interface.name }}
{% else %}
interface {{ interface.name }}
{% endif %}
{% if interface.description is defined and interface.description %}
  description {{ interface.description }}
{% endif %}
  switchport mode {{ interface.mode }}
{% if interface.mode == 'access' %}
  switchport access vlan {{ interface.access_vlan }}
{% if interface.voice_vlan is defined and interface.voice_vlan %}
  switchport voice vlan {{ interface.voice_vlan }}
{% endif %}
{% elif interface.mode == 'trunk' %}
{% if interface.allowed_vlans %}
  switchport trunk allowed vlan {{ interface.allowed_vlans }}
{% endif %}
{% endif %}
{% if interface.portfast is defined and interface.portfast %}
  spanning-tree portfast
{% endif %}
{% if interface.bpduguard is defined and interface.bpduguard %}
  spanning-tree bpduguard enable
{% endif %}
{% if interface.shutdown is defined and interface.shutdown %}
  shutdown
{% else %}
  no shutdown
{% endif %}
!
{% endfor %}

{# Port-Channel Configuration #}
{% for pc in port_channels %}
interface Port-channel{{ pc.id }}
{% if pc.description %}
  description {{ pc.description }}
{% endif %}
  switchport mode {{ pc.switchport_mode }}
{% if pc.switchport_mode == 'access' and pc.access_vlan %}
  switchport access vlan {{ pc.access_vlan }}
{% elif pc.switchport_mode == 'trunk' and pc.allowed_vlans %}
  switchport trunk allowed vlan {{ pc.allowed_vlans }}
{% endif %}
{% if pc.shutdown %}
  shutdown
{% else %}
  no shutdown
{% endif %}
!
{% for member in pc.member_interfaces %}
interface {{ member }}
{% if pc.description %}
  description {{ pc.description }}
{% endif %}
  channel-group {{ pc.id }} mode {{ pc.lacp_mode }}
  no shutdown
!
{% endfor %}
{% endfor %}

{# Default Route #}
{% if default_route is defined and default_route.gateway is defined %}
ip route 0.0.0.0 0.0.0.0 {{ default_route.gateway }}
{% endif %}
{# Static Routes #}
{% for route in static_routes %}
ip route {{ route.network }} {{ route.prefix | ip_prefix_to_netmask }} {{ route.gateway }}
{% endfor %}
