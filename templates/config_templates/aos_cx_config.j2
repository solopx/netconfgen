hostname {{ hostname }}
{% if snmp_community %}
snmp-server community {{ snmp_community }}
{% endif %}
{% if ntp_server %}
ntp server {{ ntp_server }}
{% endif %}
{% if syslog_server %}
logging {{ syslog_server }}
{% endif %}
{% if dns_server %}
ip dns server-address {{ dns_server }}
{% endif %}

{# VLAN Configuration #}
{% for vlan in vlans %}
vlan {{ vlan.id }}
  name {{ vlan.name }}
!
{% if vlan.ip_address and vlan.prefix_length %}
interface vlan {{ vlan.id }}
  description {{ vlan.description or vlan.name }}
  ip address {{ vlan.ip_address }}/{{ vlan.prefix_length }}
{% if vlan.helper_addresses %}
{% for helper in vlan.helper_addresses %}
  ip helper-address {{ helper }}
{% endfor %}
{% endif %}
!
{% endif %}
{% endfor %}

{# Physical Interface Configuration #}
{% for interface in interfaces %}
interface {{ interface.name }}
{% if interface.description is defined and interface.description %}
  description {{ interface.description }}
{% endif %}
{% if interface.is_aos_cx and interface.aos_cx_type == 'routed' %}
  routing
{% if interface.ip_address %}
  ip address {{ interface.ip_address }}/{{ interface.prefix_length or 24 }}
{% endif %}
{% else %}
  no routing
{% if interface.mode == 'access' %}
  vlan access {{ interface.access_vlan }}
{% if interface.voice_vlan is defined and interface.voice_vlan %}
  vlan trunk native {{ interface.access_vlan }}
  vlan trunk allowed {{ interface.access_vlan }},{{ interface.voice_vlan }}
{% endif %}
{% if interface.portfast is defined and interface.portfast %}
  spanning-tree port-type admin-edge
{% endif %}
{% if interface.bpduguard is defined and interface.bpduguard %}
  spanning-tree bpdu-protection
{% endif %}
{% elif interface.mode == 'trunk' %}
  vlan trunk native 1
  vlan trunk allowed {{ interface.allowed_vlans }}
{% endif %}
{% endif %}
{% if interface.shutdown is defined and interface.shutdown %}
  shutdown
{% else %}
  no shutdown
{% endif %}
!
{% endfor %}

{# Default Route #}
{% if default_route is defined and default_route.gateway is defined %}
ip route 0.0.0.0/0 {{ default_route.gateway }}
{% endif %}
